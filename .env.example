# Copy to .env and replace every value. Never commit .env.
# Use letters and digits only for passwords and tokens.
POSTGRES_USER=odoo
POSTGRES_PASSWORD=changeMeDb

ODOO_DB=7didan
ODOO_ADMIN_LOGIN=admin
ODOO_ADMIN_PASSWORD=changeMeAdmin
# Restricted account used by n8n (Sales user, CRM access only).
ODOO_INTEGRATION_LOGIN=n8n-integration
ODOO_INTEGRATION_PASSWORD=changeMeIntegration
ODOO_TIMEOUT_MS=10000

N8N_ENCRYPTION_KEY=changeMe32RandomCharacters000000
# Shared secret the FastAPI backend sends in the X-7didan-Token header.
WEBHOOK_TOKEN=changeMeWebhookToken
N8N_WEBHOOK_URL=http://localhost:5678/webhook/7didan/lead

# Database roles created by scripts/setup.py.
N8N_LOGGER_PASSWORD=changeMeLogger      # INSERT on reporting.crm_transactions only
POWERBI_READER_PASSWORD=changeMeReader  # SELECT on the reporting views only

# Frontend (docker compose service "frontend", http://localhost:3000).
# FastAPI backend URL as seen from the frontend container. Empty = demo mode.
BACKEND_URL=
