# Copy to .env.local and fill in. Never commit .env.local.
# These are server-side only: nothing here is sent to the browser.

# FastAPI backend (Amine). When set, /api/chat, /api/enquiries and /api/events are forwarded to it.
# Leave empty to run in demo mode: illustrative chat answers, enquiries sent straight to n8n.
BACKEND_URL=

# Demo mode only: Yassir's n8n webhook and its shared token (same values as WEBHOOK_TOKEN and
# N8N_WEBHOOK_URL in ../.env). With them, a demo enquiry creates a real Odoo opportunity.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/7didan/lead
WEBHOOK_TOKEN=changeMeWebhookToken
